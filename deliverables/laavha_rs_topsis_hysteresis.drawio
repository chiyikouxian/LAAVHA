        <mxCell id="xbase" parent="1" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 5;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=18;" value="&lt;div style=&quot;font-size:29px&quot;&gt;&lt;b&gt;LAAVHA 基础决策链路（结构与训练过程不变）&lt;/b&gt; /&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;LAAVHA Base Chain (trained model unchanged)&lt;/span&gt;&lt;/div&gt;" vertex="1">
