        <mxCell id="xnote" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:17px;line-height:1.35&quot;&gt;ALERA 仅在决策层引入 ADH 与 RS-TOPSIS 两项增强机制&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;ALERA introduces ADH and RS-TOPSIS at the decision layer only&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="1390" x="50" y="595" as="geometry" />
        </mxCell>
        <mxCell id="xrs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=18;" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;2.4.2 RS-TOPSIS 风险敏感排序&lt;/b&gt; /&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Risk-Sensitive TOPSIS&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="562" width="480" x="1720" y="40" as="geometry" />
        </mxCell>
        <mxCell id="xhistory" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;贴近度历史缓存 (近 K&lt;sub&gt;c&lt;/sub&gt; = 5 轮)&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Closeness History Buffer (last K&lt;sub&gt;c&lt;/sub&gt; = 5 rounds)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="150" as="geometry" />
        </mxCell>
        <mxCell id="xsigma" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;贴近度波动 σ&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;C&lt;/sup&gt; = std(C&lt;sub&gt;i&lt;/sub&gt;)&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Closeness Volatility σ&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;C&lt;/sup&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="263" as="geometry" />
        </mxCell>
        <mxCell id="xrobust" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;风险惩罚 C&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;robust&lt;/sup&gt; = C&lt;sub&gt;i&lt;/sub&gt; − λσ&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;C&lt;/sup&gt;, λ = 0.5&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Risk Penalty&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="376" as="geometry" />
        </mxCell>
        <mxCell id="xrank" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;鲁棒排序 N* = argmax&lt;sub&gt;i&lt;/sub&gt; C&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;robust&lt;/sup&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Robust Ranking&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="489" as="geometry" />
        </mxCell>
        <mxCell id="xadh" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=18;" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;2.4.1 ADH 自适应滞后&lt;/b&gt; /&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Adaptive Hysteresis&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="520" x="470" y="740" as="geometry" />
