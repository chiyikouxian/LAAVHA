        </mxCell>
        <mxCell id="xadhnote" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:21px;line-height:1.35&quot;&gt;信道波动越大 → 门限越高; 飞行速度越快 → 周期越短&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Higher volatility → higher threshold; higher velocity → shorter duration&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="15" width="520" x="980" y="940" as="geometry" />
