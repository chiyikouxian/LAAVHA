        <mxCell id="xtopsis" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:19px;line-height:1.45&quot;&gt;改进 TOPSIS 决策&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Improved TOPSIS&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;融合 → 成本型取反 →&lt;br&gt;归一化 → 加权 →&lt;br&gt;理想解 → 贴近度&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="270" x="980" y="220" as="geometry" />
