        <mxCell id="xspred" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;i&gt;S&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;pred&lt;/sub&gt; ∈ &lt;b&gt;R&lt;/b&gt;&lt;sup&gt;3×5&lt;/sup&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Predicted State&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="130" x="760" y="177" as="geometry" />
        </mxCell>
        <mxCell id="xw" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;i&gt;w&lt;/i&gt; ∈ &lt;b&gt;R&lt;/b&gt;&lt;sup&gt;5&lt;/sup&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Dynamic Weights&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="130" x="760" y="467" as="geometry" />
        </mxCell>
        <mxCell id="xtopsis" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:24px;line-height:1.45&quot;&gt;改进 TOPSIS 决策&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Improved TOPSIS&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;融合 → 成本型取反 →&lt;br&gt;归一化 → 加权 →&lt;br&gt;理想解 → 贴近度&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:px&quot;&gt;&lt;i&gt;S&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;cur&lt;/sub&gt; + &lt;i&gt;S&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;pred&lt;/sub&gt; + &lt;i&gt;w&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="270" x="980" y="220" as="geometry" />
        </mxCell>
        <mxCell id="xci" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;i style=&quot;&quot;&gt;C&lt;sub style=&quot;&quot;&gt;i&lt;/sub&gt;&lt;/i&gt; ∈ [0, 1]&lt;br&gt;Closeness Coefficient&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="110" x="1330" y="297" as="geometry" />
        </mxCell>
        <mxCell id="xnote" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;ALERA 仅在决策层引入 ADH 与 RS-TOPSIS 两项增强机制&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;ALERA introduces ADH and RS-TOPSIS at the decision layer only&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="1390" x="50" y="595" as="geometry" />
        </mxCell>
        <mxCell id="xrs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=18;" value="&lt;div style=&quot;font-size:29px&quot;&gt;&lt;b&gt;2.4.2 RS-TOPSIS 风险敏感排序&lt;/b&gt; /&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;Risk-Sensitive TOPSIS&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="562" width="480" x="1720" y="40" as="geometry" />
        </mxCell>
        <mxCell id="xhistory" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;贴近度历史缓存 (近 &lt;i&gt;K&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt; = 5 轮)&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Closeness History Buffer (last &lt;i&gt;K&lt;/i&gt;&lt;sub&gt;c&lt;/sub&gt; = 5 rounds)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="150" as="geometry" />
        </mxCell>
        <mxCell id="xsigma" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;贴近度波动 &lt;i&gt;σ&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;&lt;sup style=&quot;font-style:normal&quot;&gt;C&lt;/sup&gt; = &lt;span style=&quot;font-style:normal&quot;&gt;std&lt;/span&gt;(&lt;i&gt;C&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;)&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Closeness Volatility &lt;i&gt;σ&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;&lt;sup style=&quot;font-style:normal&quot;&gt;C&lt;/sup&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="263" as="geometry" />
        </mxCell>
        <mxCell id="xrobust" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;风险惩罚 &lt;i&gt;C&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;i&lt;/sub&gt;&lt;sup style=&quot;font-style:normal&quot;&gt;robust&lt;/sup&gt; = &lt;i&gt;C&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;i&lt;/sub&gt; − &lt;i&gt;λσ&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;C&lt;/sup&gt;, &lt;i&gt;λ&lt;/i&gt; = 0.5&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Risk Penalty&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="376" as="geometry" />
        </mxCell>
        <mxCell id="xrank" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;鲁棒排序 &lt;i&gt;N&lt;sup&gt;*&lt;/sup&gt;&lt;/i&gt; = &lt;span style=&quot;font-style:normal&quot;&gt;arg max&lt;/span&gt;&lt;sub&gt;&lt;i&gt;i&lt;/i&gt;&lt;/sub&gt; &lt;i&gt;C&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt;&lt;sup style=&quot;font-style:normal&quot;&gt;robust&lt;/sup&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Robust Ranking&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="420" x="1750" y="489" as="geometry" />
        </mxCell>
        <mxCell id="xadh" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=top;spacingTop=18;" value="&lt;div style=&quot;font-size:29px&quot;&gt;&lt;b&gt;2.4.1 ADH 自适应滞后&lt;/b&gt; /&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;Adaptive Hysteresis&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="520" x="470" y="715" as="geometry" />
        </mxCell>
        <mxCell id="xsinr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;服务网络近 5 周期&lt;br&gt;SINR 标准差 &lt;i&gt;σ&lt;/i&gt; ∈ [0, 10]&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;SINR Std. of Serving Network&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="50" y="765" as="geometry" />
        </mxCell>
        <mxCell id="xvel" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;飞行速度&lt;br&gt;&lt;i&gt;v&lt;/i&gt; ∈ [0, 30] m/s&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Flight Velocity&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="50" y="965" as="geometry" />
        </mxCell>
        <mxCell id="xdelta" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;自适应门限 &lt;i&gt;Δ&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;th&lt;/sub&gt; = 0.03 + 0.05(&lt;i&gt;σ&lt;/i&gt; / 10)&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Adaptive Threshold, &lt;i&gt;Δ&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;th&lt;/sub&gt; ∈ [0.03, 0.08]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="450" x="500" y="820" as="geometry" />
        </mxCell>
        <mxCell id="xth" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:23px;line-height:1.4&quot;&gt;自适应周期 &lt;i&gt;T&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;h&lt;/sub&gt; = max(2, ⌊4 − 2&lt;i&gt;v&lt;/i&gt; / 30⌋)&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Adaptive Duration, &lt;i&gt;T&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;h&lt;/sub&gt; ∈ [2, 4]&lt;/span&gt;&lt;/div&gt;" vertex="1">
