        <mxCell id="xlstm" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:19px;line-height:1.4&quot;&gt;堆叠 LSTM 预测&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Stacked LSTM Prediction&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;(LSTM&lt;sub&gt;1&lt;/sub&gt; → LSTM&lt;sub&gt;2&lt;/sub&gt; → &lt;span style=&quot;font-family:Arial,sans-serif&quot;&gt;fc&lt;sub&gt;pred&lt;/sub&gt;&lt;/span&gt;)&lt;/span&gt;&lt;/div&gt;" vertex="1">
