        </mxCell>
        <mxCell id="xattn" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:19px;line-height:1.4&quot;&gt;注意力动态权重&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Attention Dynamic Weights&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;(Self-Attention → Softmax)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="360" y="440" as="geometry" />
