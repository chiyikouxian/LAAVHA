        <mxCell id="xspred" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:19px&quot;&gt;S&lt;sub&gt;pred&lt;/sub&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;R&lt;sup&gt;3×5&lt;/sup&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
