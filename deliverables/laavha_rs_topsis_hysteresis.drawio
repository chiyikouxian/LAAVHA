        <mxCell id="xci" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:19px&quot;&gt;C&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;[0, 1]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="110" x="1330" y="297" as="geometry" />
