        <mxCell id="xadhnote" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:16px;line-height:1.35&quot;&gt;信道波动越大 → 门限越高; 飞行速度越快 → 周期越短&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Higher volatility → higher threshold; higher velocity → shorter duration&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="620" x="1080" y="908" as="geometry" />
        </mxCell>
        <mxCell id="xncur" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.35&quot;&gt;当前服务网络 N&lt;sub&gt;cur&lt;/sub&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Current Serving Network N&lt;sub&gt;cur&lt;/sub&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="1850" y="692" as="geometry" />
        </mxCell>
        <mxCell id="xdual" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:22px;line-height:1.35&quot;&gt;&lt;b&gt;双重滞后判决&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:19px&quot;&gt;Dual Hysteresis Decision&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;C&lt;sup&gt;robust&lt;/sup&gt;(N*) − C&lt;sup&gt;robust&lt;/sup&gt;(N&lt;sub&gt;cur&lt;/sub&gt;) &gt; Δ&lt;sub&gt;th&lt;/sub&gt;&lt;br&gt;且连续 T&lt;sub&gt;h&lt;/sub&gt; 个决策周期成立&lt;/span&gt;&lt;/div&gt;" vertex="1">
