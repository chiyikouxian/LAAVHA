        <mxCell id="xsinr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;服务网络近 5 周期&lt;br&gt;SINR 标准差 σ ∈ [0, 10]&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;SINR Std. of Serving Network&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="50" y="765" as="geometry" />
        </mxCell>
        <mxCell id="xvel" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;飞行速度&lt;br&gt;v ∈ [0, 30] m/s&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Flight Velocity&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="50" y="965" as="geometry" />
        </mxCell>
        <mxCell id="xdelta" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;自适应门限 Δ&lt;sub&gt;th&lt;/sub&gt; = 0.03 + 0.05(σ / 10)&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Adaptive Threshold, Δ&lt;sub&gt;th&lt;/sub&gt; ∈ [0.03, 0.08]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="450" x="500" y="820" as="geometry" />
        </mxCell>
        <mxCell id="xth" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:18px;line-height:1.4&quot;&gt;自适应周期 T&lt;sub&gt;h&lt;/sub&gt; = max(2, ⌊4 − 2v / 30⌋)&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Adaptive Duration, T&lt;sub&gt;h&lt;/sub&gt; ∈ [2, 4]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="450" x="500" y="975" as="geometry" />
