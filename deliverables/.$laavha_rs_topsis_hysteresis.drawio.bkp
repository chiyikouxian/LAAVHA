        <mxCell id="xkeep" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontFamily=Times New Roman;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size:29px;line-height:1.4&quot;&gt;保持 &lt;i&gt;N&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;cur&lt;/sub&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;(不执行切换)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;Keep &lt;i&gt;N&lt;/i&gt;&lt;sub style=&quot;font-style:normal&quot;&gt;cur&lt;/sub&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
